h='url(#f32)'><g><animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/><use href='#r32'/></g></g></g><g transform='translate(450 61.8) scale(1 0.3746)'><g clip-path='url(#f33)'><g><animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/><use href='#r33'/></g></g></g><g transform='translate(450 57.4) scale(1 0.3746)'><g clip-path='url(#f34)'><g><animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/><use href='#r34'/></g></g></g><g transform='translate(450 53.7) scale(1 0.3746)'><g clip-path='url(#f35)'><g><animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/><use href='#r35'/></g></g></g><g transform='translate(450 50.7) scale(1 0.3746)'><g clip-path='url(#f36)'><g><animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/><use href='#r36'/></g></g></g><g transform='translate(450 48.4) scale(1 0.3746)'><g clip-path='url(#f37)'><g><animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/><use href='#r37'/></g></g></g></g>"
VAR _max = MAX ( 'Globe Data'[co2_mt] )
VAR _bubbles =
    CONCATENATEX (
        'Globe Data',
        VAR _size = 4 + 44 * SQRT ( DIVIDE ( 'Globe Data'[co2_mt], _max ) )   // bubble diameter
        RETURN
            "<g transform='translate(450 " & 'Globe Data'[ring_y] & ") scale(1 0.3746)'><g>"
                & "<animateTransform attributeName='transform' type='rotate' from='0' to='-360' dur='70s' repeatCount='indefinite'/>"
                & "<path d='M" & 'Globe Data'[px] & " " & 'Globe Data'[py] & "h0' stroke='#5C6B7A' stroke-width='"
                & ROUND ( _size, 0 ) & "'>"
                & "<animate attributeName='stroke-opacity' values='" & 'Globe Data'[op_values]
                & "' keyTimes='" & 'Globe Data'[op_keys] & "' calcMode='discrete' dur='70s' repeatCount='indefinite'/>"
                & "<title>" & 'Globe Data'[country] & "</title></path></g></g>",
        ""
    )
VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='570' height='570' viewBox='165 -49 570 570' preserveAspectRatio='xMidYMid meet'>" & _static & _bubbles & "</svg>"
RETURN
    // '#' has to be escaped inside a data URI
    "data:image/svg+xml;utf8," & SUBSTITUTE ( _svg, "#", "%23" )


Globe motion table (Modeling > New table):

Globe motion = DATATABLE ( "Motion", STRING, "Order", INTEGER, { { "Play", 1 }, { "Pause", 2 } } )


Pause-aware measure (Data category: Image URL) - use this one in the Image visual
and add a button slicer on 'Globe motion'[Motion] with Single select on:

Globe live =
VAR _paused = SELECTEDVALUE ( 'Globe motion'[Motion] ) = "Pause"
RETURN
    IF ( _paused, SUBSTITUTE ( [Globe], "dur='70s'", "dur='9999999s'" ), [Globe] )
