                }
              }
            },
            "sourceUrl": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Globe Data"
                    }
                  },
                  "Property": "Globe live"
                }
              }
            },
            "fit": {
              "expr": {
                "Literal": {
                  "Value": "'Fill'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}